<h1>Books</h1>

<table>
  <tr>
    <th>Title</th>
    <th>Author</th>
    <th>Pages</th>
  </tr>
  <% @books.each do |book| %>
    <tr>
      <td><%= book.title %></td>
      <td><%= book.author %></td>
      <td><%= book.pages %></td>
    </tr>
  <% end %>
</table>

<p>
  <%= @books.length %> books,
  <%= @books.map { |b| b.pages.to_i }.inject(0) { |a, b| a + b } %> pages
</p>
