<% content_for :title, @book.title %>

<h1><%= @book.title %></h1>

<% if @book.cover_url.present? %>
  <%= image_tag @book.cover_url, class: 'cover', alt: @book.title %>
<% end %>

<p><%= @book.author %></p>
<p><%= @book.pages %> pages</p>
<p>ISBN <%= @book.isbn %></p>
<p><%= @book.status %><% if @book.finished_on %>,
  finished <%= @book.finished_on.strftime('%B %-d') %><% end %></p>
<p><%= @book.stars %></p>

<p class="tags">
  <% @book.tags.each do |tag| %>
    <%= link_to tag.name, books_path(tag: tag.name), class: 'tag' %>
  <% end %>
</p>

<h2>Notes</h2>

<% if @book.notes.empty? %>
  <p class="empty">Nothing yet.</p>
<% end %>

<ul class="notes">
  <% @book.notes.each do |note| %>
    <li>
      <% if note.page %><span class="page">p<%= note.page %></span><% end %>
      <%= simple_format note.body %>
      <% if logged_in? %>
        <%= link_to 'x', book_note_path(@book, note), method: :delete %>
      <% end %>
    </li>
  <% end %>
</ul>

<% if logged_in? %>
  <%= form_for [@book, Note.new] do |f| %>
    <p><%= f.text_area :body, rows: 3 %></p>
    <p><%= f.label :page %> <%= f.number_field :page %>
       <%= f.submit 'Add note' %></p>
  <% end %>
<% end %>

<%= link_to 'Edit', edit_book_path(@book) %> |
<%= link_to 'Delete', @book, method: :delete, data: { confirm: 'Sure?' } %> |
<%= link_to 'Back', books_path %>
