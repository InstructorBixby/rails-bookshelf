<!DOCTYPE html>
<html>
<head>
  <title>Bookshelf</title>
  <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track' => 'reload' %>
  <%= javascript_include_tag 'application', 'data-turbolinks-track' => 'reload' %>
  <%= csrf_meta_tags %>
</head>
<body>

<div class="container">
  <p class="nav">
    <%= link_to 'Bookshelf', root_path %>
    <%= link_to 'stats', stats_path %>
    <% if logged_in? %>
      <span class="right">
        <%= current_user.name %>
        <%= link_to 'log out', logout_path, method: :delete %>
      </span>
    <% else %>
      <span class="right"><%= link_to 'log in', login_path %></span>
    <% end %>
  </p>

  <% if notice %>
    <p class="notice"><%= notice %></p>
  <% end %>
  <% if flash[:alert] %>
    <p class="errors"><%= flash[:alert] %></p>
  <% end %>

  <%= yield %>
</div>

</body>
</html>
