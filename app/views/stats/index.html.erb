<h1>Stats</h1>

<% if @goal %>
  <h2>This year</h2>
  <p><%= @goal.finished %> of <%= @goal.target %></p>
  <div class="bar"><div class="fill" style="width: <%= @goal.percent %>%"></div></div>
<% end %>

<% if logged_in? %>
  <%= form_tag goals_path, class: 'goal' do %>
    <%= number_field_tag :target, @goal ? @goal.target : nil, min: 1 %>
    <%= submit_tag @goal ? 'Change goal' : 'Set a goal', name: nil %>
  <% end %>
<% end %>

<p><%= @total %> books finished, <%= number_with_delimiter @pages %> pages.</p>

<h2>Per month</h2>
<table>
  <% @by_month.each do |month, count| %>
    <tr>
      <td><%= month %></td>
      <td><%= '#' * count %> <%= count %></td>
    </tr>
  <% end %>
</table>

<h2>Ratings</h2>
<table>
  <% 5.downto(1) do |r| %>
    <tr>
      <td><%= '*' * r %></td>
      <td><%= @by_rating[r] || 0 %></td>
    </tr>
  <% end %>
</table>
