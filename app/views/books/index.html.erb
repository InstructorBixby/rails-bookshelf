<h1>Books</h1>

<%= form_tag books_path, method: :get, class: 'search' do %>
  <%= text_field_tag :q, @q, placeholder: 'title or author' %>
  <%= submit_tag 'Search', name: nil %>
<% end %>

<p class="filters">
  <%= link_to 'all', books_path %> |
  <% Book::STATUSES.each do |s| %>
    <%= link_to s, books_path(status: s) %>
  <% end %>
</p>

<table>
  <tr>
    <th>Title</th>
    <th>Author</th>
    <th>Pages</th>
    <th>Status</th>
    <th></th>
  </tr>
  <% @books.each do |book| %>
    <tr>
      <td><%= link_to book.title, book %></td>
      <td><%= book.author %></td>
      <td><%= book.pages %></td>
      <td><%= book.status %></td>
      <td><%= link_to 'Edit', edit_book_path(book) %></td>
    </tr>
  <% end %>
</table>

<%= will_paginate @books %>

<%= link_to 'Add a book', new_book_path %>
