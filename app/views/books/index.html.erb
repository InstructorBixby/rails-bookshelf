<h1>Books</h1>

<%= render 'search' %>

<% if @books.empty? %>
  <p class="empty">
    <% if @q.present? || @tag.present? %>
      Nothing matches that.
    <% else %>
      No books yet.
    <% end %>
  </p>
<% else %>
  <table>
    <tr>
      <th><%= link_to 'Title', books_path(sort: 'title', status: @status) %></th>
      <th><%= link_to 'Author', books_path(sort: 'author', status: @status) %></th>
      <th>Pages</th>
      <th>Status</th>
      <th><%= link_to 'Rating', books_path(sort: 'rating', status: @status) %></th>
      <th>Tags</th>
      <th></th>
    </tr>
    <%= render partial: 'row', collection: @books, as: :book %>
  </table>

  <%= will_paginate @books %>
<% end %>

<%= link_to 'Add a book', new_book_path %>
